{
"version": "2.0.0",
"tasks": [
    {
        "label": "Run Debug",
        "type": "shell",
        "command": "dotnet serve --mime .wasm=application/wasm --mime .js=text/javascript --mime .json=application/json --directory bin/Debug/net10.0/browser-wasm/AppBundle/",
        "options": {
            "cwd": "${workspaceFolder}/CodeBase/RaylibWasm"
        },
        "problemMatcher": [],
        "group": {
            "kind": "build",
            "isDefault": true
        }
    },
